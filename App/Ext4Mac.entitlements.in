<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The same group the extension declares, and the only thing the two
	     processes share. The app derives an encrypted volume's master key and
	     leaves it here; the extension reads it at mount time. There is no
	     other channel, because an app extension has no IPC back to its host.

	     Authorised by App/Ext4Mac.provisionprofile, which is issued for this
	     app's own bundle ID. Nothing here is optional: without the
	     application-identifier the system cannot match the profile to the
	     binary, and a keychain group that no profile authorises gets the
	     process killed by AMFI at launch rather than refused at the call. -->
	<key>com.apple.application-identifier</key>
	<string>@TEAM_ID@.@BUNDLE_ID@</string>
	<key>com.apple.developer.team-identifier</key>
	<string>@TEAM_ID@</string>

	<key>keychain-access-groups</key>
	<array>
		<string>@TEAM_ID@.@BUNDLE_ID@.shared</string>
	</array>
</dict>
</plist>
