<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ties this binary to the provisioning profile. Without it the system
	     cannot match the profile, so the restricted fskit entitlement below is
	     never authorised and fskitd fails to launch the extension with
	     "Couldn't communicate with a helper application". -->
	<key>com.apple.application-identifier</key>
	<string>BDLYXW7QMN.dev.h3ct0r.ext4mac.Ext4FS</string>
	<key>com.apple.developer.team-identifier</key>
	<string>BDLYXW7QMN</string>

	<!-- Declares this extension as an FSKit filesystem module. Restricted:
	     requires the profile above. -->
	<key>com.apple.developer.fskit.fsmodule</key>
	<true/>

	<!-- FSKit modules run sandboxed. FSKit itself grants access to the block
	     device it asks us to mount; nothing else is needed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Reach the privileged barrier helper.

	     The write barrier is one ioctl, DKIOCSYNCHRONIZECACHE, and this
	     process may not issue it. The sandbox denies it by name:

	       Sandbox: Ext4FS deny(1) file-ioctl path:/dev/rdiskN
	                ioctl-command:(_IO "d" 22)

	     Nothing lifts that. A file path exception grants file-read and
	     file-write, not file-ioctl, and the IOKit user client exception that
	     Apple's own msdos module carries changes nothing here; both were
	     signed and measured, and the denial came back identical. So the ioctl
	     is issued by a LaunchDaemon instead, and this is the entitlement that
	     lets us talk to it.

	     Unlike file-ioctl, mach-lookup does have a documented exception, which
	     is the whole reason this approach is available at all.

	     Note for anyone editing the comments in this file: AMFI parses it with
	     a stricter XML reader than plutil uses, and a double hyphen inside an
	     XML comment is a syntax error it rejects the whole file over. -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>dev.h3ct0r.ext4mac.barrier</string>
	</array>

	<!-- Shared with the container app, so it can hand over the master key for
	     an encrypted volume without the passphrase ever entering this
	     sandboxed process. Already authorised by the provisioning profile,
	     which carries keychain-access-groups for BDLYXW7QMN.*, so this needs no
	     new profile.

	     The first entry is the default access group for items this binary
	     creates, which is why nothing in the source names a group: the
	     entitlement is the single place it is written down. Access groups only
	     apply to the data protection keychain, so every query passes
	     kSecUseDataProtectionKeychain. -->
	<key>keychain-access-groups</key>
	<array>
		<string>BDLYXW7QMN.dev.h3ct0r.ext4mac.shared</string>
	</array>
</dict>
</plist>
