<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>open_ext4 (ext2/3/4)</string>
	<key>CFBundleExecutable</key>
	<string>Ext4FS</string>
	<key>CFBundleIdentifier</key>
	<string>dev.h3ct0r.ext4mac.Ext4FS</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Ext4FS</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.4</string>
	<key>EXAppExtensionAttributes</key>
	<dict>
		<key>EXExtensionPointIdentifier</key>
		<string>com.apple.fskit.fsmodule</string>

		<!-- Short name shown in System Settings > Login Items & Extensions. -->
		<key>FSShortName</key>
		<string>ext4</string>

		<!-- We consume a raw block device (a disk partition), not a URL. -->
		<key>FSSupportsBlockResources</key>
		<true/>
		<key>FSSupportsGenericURLResources</key>
		<false/>
		<key>FSSupportsPathURLs</key>
		<false/>
		<key>FSSupportsServerURLs</key>
		<false/>
		<key>FSRequiresSecurityScopedPathURLResources</key>
		<false/>

		<!-- Hand the kernel extent maps instead of copying file data over XPC. -->
		<key>FSSupportsKernelOffloadedIO</key>
		<true/>

		<!--
		    Option syntax for the maintenance operations, in getopt form.
		    FSKit parses the command line against these before calling
		    startFormat/startCheck, so anything not listed here is rejected
		    for us. Reached through the generic drivers macOS ships:

		        newfs_fskit -t ext4 [-g 2|3|4] [-b bytes] [-L label]
		                            [-I bytes] [-N count] [-J blocks] [-n]
		                            /dev/diskNsM
		        fsck_fskit  -t ext4 [-n] /dev/diskNsM

		    -g picks the filesystem generation because `-t` already means
		    "which FSKit module" to newfs_fskit, and one module serves
		    ext2, ext3 and ext4.
		-->
		<key>FSFormatOptionSyntax</key>
		<dict>
			<key>shortOptions</key>
			<string>g:b:L:I:N:J:n</string>
		</dict>
		<key>FSCheckOptionSyntax</key>
		<dict>
			<key>shortOptions</key>
			<string>n</string>
		</dict>

		<!--
		    One personality per filesystem generation. FSSubType is what
		    `mount -t` and Disk Utility use to tell them apart; the values
		    match the convention Apple's own modules follow.
		    ext filenames are byte strings compared exactly, hence
		    FSfileObjectsAreCaseSensitive.

		    The FSFormat* keys describe what this personality can be
		    created on. The minimum for ext3/ext4 is set by the journal:
		    lwext4 never makes one smaller than 1024 blocks, which is
		    4 MiB at the default 4 KiB block size, and 6 MiB is the
		    smallest volume that actually formats cleanly. ext2 has no
		    journal and works from 1 MiB. The maximum is 2^32 blocks of
		    4 KiB -- lwext4's mkfs does not set the 64bit feature.
		-->
		<key>FSPersonalities</key>
		<dict>
			<key>ext2</key>
			<dict>
				<key>FSName</key>
				<string>ext2</string>
				<key>FSSubType</key>
				<integer>0</integer>
				<key>FSfileObjectsAreCaseSensitive</key>
				<true/>
				<key>FSFormatContentMask</key>
				<string>0FC63DAF-8483-4772-8E79-3D69D8477DE4</string>
				<key>FSFormatMinimumSize</key>
				<integer>1048576</integer>
				<key>FSFormatMaximumSize</key>
				<integer>17592186044416</integer>
				<key>FSFormatArguments</key>
				<string>-g 2</string>
			</dict>
			<key>ext3</key>
			<dict>
				<key>FSName</key>
				<string>ext3</string>
				<key>FSSubType</key>
				<integer>1</integer>
				<key>FSfileObjectsAreCaseSensitive</key>
				<true/>
				<key>FSFormatContentMask</key>
				<string>0FC63DAF-8483-4772-8E79-3D69D8477DE4</string>
				<key>FSFormatMinimumSize</key>
				<integer>8388608</integer>
				<key>FSFormatMaximumSize</key>
				<integer>17592186044416</integer>
				<key>FSFormatArguments</key>
				<string>-g 3</string>
			</dict>
			<key>ext4</key>
			<dict>
				<key>FSName</key>
				<string>ext4</string>
				<key>FSSubType</key>
				<integer>2</integer>
				<key>FSfileObjectsAreCaseSensitive</key>
				<true/>
				<key>FSFormatContentMask</key>
				<string>0FC63DAF-8483-4772-8E79-3D69D8477DE4</string>
				<key>FSFormatMinimumSize</key>
				<integer>8388608</integer>
				<key>FSFormatMaximumSize</key>
				<integer>17592186044416</integer>
				<key>FSFormatArguments</key>
				<string>-g 4</string>
			</dict>
		</dict>

		<!--
		    Media this module will be offered. The GPT type GUID for a Linux
		    filesystem, the MBR 0x83 content hint ("Linux"), and whole
		    unpartitioned devices, which is how a raw-formatted USB stick or a
		    disk image attached with hdiutil appears.
		-->
		<key>FSMediaTypes</key>
		<dict>
			<key>0FC63DAF-8483-4772-8E79-3D69D8477DE4</key>
			<dict>
				<key>FSMediaProperties</key>
				<dict>
					<key>Content Hint</key>
					<string>0FC63DAF-8483-4772-8E79-3D69D8477DE4</string>
					<key>Leaf</key>
					<true/>
				</dict>
			</dict>
			<key>Linux</key>
			<dict>
				<key>FSMediaProperties</key>
				<dict>
					<key>Content Hint</key>
					<string>Linux</string>
					<key>Leaf</key>
					<true/>
				</dict>
			</dict>
			<key>Whole</key>
			<dict>
				<key>FSMediaProperties</key>
				<dict>
					<key>Leaf</key>
					<true/>
					<key>Whole</key>
					<true/>
				</dict>
			</dict>
		</dict>

		<!--
		    getopt strings for options accepted by mount / fsck / mkfs.
		    -o is the standard mount option list; --rdonly and -f are handled
		    by FSKit itself for unary filesystems.
		-->
		<key>FSActivateOptionSyntax</key>
		<dict>
			<key>shortOptions</key>
			<string>o:</string>
		</dict>
	</dict>
</dict>
</plist>
