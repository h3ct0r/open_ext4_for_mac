<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ties this binary to the provisioning profile. Without it the system
	     cannot match the profile, so the restricted fskit entitlement below is
	     never authorised and fskitd fails to launch the extension with
	     "Couldn't communicate with a helper application". -->
	<key>com.apple.application-identifier</key>
	<string>@TEAM_ID@.@BUNDLE_ID@</string>
	<key>com.apple.developer.team-identifier</key>
	<string>@TEAM_ID@</string>

	<!-- Declares this extension as an FSKit filesystem module. Restricted:
	     requires the profile above. -->
	<key>com.apple.developer.fskit.fsmodule</key>
	<true/>

	<!-- FSKit modules run sandboxed. FSKit itself grants access to the block
	     device it asks us to mount; nothing else is needed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
