#!/bin/bash
#
# fsck_ext4 — bridge from Disk Utility's fsck convention to FSKit.
# SPDX-License-Identifier: GPL-3.0-or-later
#
# What this does, precisely -- because the honest description is subtle. The
# extension parses the superblock, applies the feature gate, verifies the
# checksum seed, and replays a dirty journal. Replaying the journal IS the
# standard repair for a journaled filesystem: a dirty ext4 is *made consistent*
# by replaying, which is exactly what a power-cut volume needs. What this does
# NOT do is a full structural check -- walking the inode table, cross-checking
# block bitmaps against extent trees -- because lwext4 has no fsck. So it can
# recover a dirty volume but cannot repair structural damage; for the latter,
# e2fsprogs. Earlier this script claimed it "cannot repair one" even as it
# replayed the journal, which was the opposite of honest.
set -u

self=$(basename "$0")
args=()
repair_requested=0

while [ $# -gt 1 ]; do
    case "$1" in
        -n) args+=(-n) ;;
        -y|-p) repair_requested=1 ;;   # repair / preen: replay if dirty
        -f|-q|-d) ;;   # force/quiet/debug: nothing for us to vary
        *) echo "$self: unsupported option $1" >&2; exit 1 ;;
    esac
    shift
done

[ $# -eq 1 ] || { echo "usage: $self [-n|-y|-p] device" >&2; exit 1; }
device="$1"

if [ "$repair_requested" -eq 1 ]; then
    echo "$self: recovering by replaying the journal if the volume is dirty" >&2
    echo "$self: (the standard repair for ext3/4); for a full structural" >&2
    echo "$self: check of a clean volume, run e2fsck from e2fsprogs." >&2
fi

# FSKit modules are enabled per user, and fskitd will not start a third-party
# module on behalf of root -- which is who runs First Aid's checks. Same
# re-dispatch as newfs_ext4: enter the console user's bootstrap context and
# run as them, because theirs is the enablement that exists.
#
# macOS ships bash 3.2, where expanding an empty array under `set -u` is an
# unbound-variable error rather than nothing. First Aid passes no options we
# forward, so the empty case is the common one.
if [ "$(id -u)" -eq 0 ]; then
    console_uid=$(/usr/bin/stat -f %u /dev/console 2>/dev/null || echo 0)
    if [ "$console_uid" -gt 0 ]; then
        exec /bin/launchctl asuser "$console_uid" \
             /usr/bin/sudo -n -u "#$console_uid" \
             /sbin/fsck_fskit -t ext4 ${args[@]+"${args[@]}"} "$device"
    fi
fi

exec /sbin/fsck_fskit -t ext4 ${args[@]+"${args[@]}"} "$device"
