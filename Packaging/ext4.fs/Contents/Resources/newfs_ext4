#!/bin/bash
#
# newfs_ext4 — bridge from Disk Utility's newfs convention to FSKit.
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Disk Utility and diskutil(8) find formatters through .fs bundles in
# /Library/Filesystems, not through FSKit. They invoke the personality's
# FSFormatExecutable as
#
#     <formatter> <FSFormatArguments...> -v <label> <device>
#
# so this translates that into a call to the module-agnostic formatter macOS
# ships, which dispatches to our FSKit extension:
#
#     newfs_fskit -t ext4 -g <2|3|4> [-L <label>] <device>
#
# It carries no filesystem logic of its own on purpose: everything that decides
# what lands on disk lives in the extension, where it is tested.
set -u

self=$(basename "$0")
gen=4
label=""

usage() {
    echo "usage: $self [-2|-3|-4] [-v label] device" >&2
    exit 1
}

# Every argument but the last is an option; the device comes last.
while [ $# -gt 1 ]; do
    case "$1" in
        -2) gen=2 ;;
        -3) gen=3 ;;
        -4) gen=4 ;;
        -v)
            shift
            [ $# -gt 1 ] || usage
            label="$1"
            ;;
        *)
            # Refuse rather than guess. Silently dropping an option the caller
            # believed was applied is how a volume ends up not being what the
            # user asked for.
            echo "$self: unsupported option $1" >&2
            usage
            ;;
    esac
    shift
done

[ $# -eq 1 ] || usage
device="$1"

args=(-t ext4 -g "$gen")
[ -n "$label" ] && args+=(-L "$label")

# >>> ext4.fs dispatch — identical in newfs_ext4 and fsck_ext4. The suite
#     diffs the two blocks and fails if they drift; edit both or neither.
#
# FSKit modules are enabled per user, and fskitd will not start a third-party
# module on behalf of root -- but Disk Utility's backend (storagekitd, which
# fork/execs a personality's tool through DMToolProcess) runs formatters and
# checkers exactly as root. A bare exec therefore fails with "No extension
# with fsShortName found" and Erase reports "File system formatter failed".
#
# The answer here used to be to re-dispatch to the console user: launchctl
# asuser into their bootstrap context, sudo -n to their uid. That moved the
# failure rather than fixing it. newfs_fskit opens the device IN ITS OWN
# PROCESS -- it holds no device-opening entitlement, only a mach-lookup
# exception for fskitd -- so on a physical disk, whose node is root:operator
# mode 0640, the console user's open returned EACCES before this module was
# ever asked. That is the whole of "-69832" on real hardware, and the old
# comment claiming fskit_helper did the open was simply wrong: fskit_helper
# is on the mount path.
#
# newfs_fskit already knows how to be both things at once. Run it as root
# with SUDO_UID set and, before it touches FSKit, it does
# setreuid(SUDO_UID, -1): the REAL uid becomes the console user, so fskitd's
# audit-token lookup finds their enabled module, while the EFFECTIVE uid
# stays 0, so the open(2) on a root-owned node succeeds. It is what plain
# `sudo newfs_fskit` has always done, because sudo sets SUDO_UID itself.
#
# Verified by disassembly (getenv -> getuid -> strtoul -> setreuid with a
# second argument of -1) and asserted from two directions in
# Tests/run_diskutil_tests.sh: the string and symbol are still in the
# shipped binary, and without SUDO_UID the same command cannot find the
# module. Nothing is chowned, nothing is borrowed, nothing has to be given
# back.
if [ "$(id -u)" -eq 0 ]; then
    console_uid=$(/usr/bin/stat -f %u /dev/console 2>/dev/null || echo 0)
    case "$console_uid" in ''|*[!0-9]*) console_uid=0 ;; esac
    if [ "$console_uid" -gt 0 ]; then
        # export, not a `VAR=x exec ...` prefix: an assignment before a
        # special builtin sets a shell variable without exporting it, so the
        # convenient spelling would pass nothing at all.
        export SUDO_UID="$console_uid"
        /usr/bin/logger -t ext4.fs "$self: running as root with SUDO_UID=$console_uid for $device"
    else
        /usr/bin/logger -t ext4.fs "$self: no console user; the module lookup will fail"
    fi
fi
# <<< ext4.fs dispatch

exec /sbin/newfs_fskit "${args[@]}" "$device"
