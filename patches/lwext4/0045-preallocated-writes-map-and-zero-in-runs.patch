+				    ext4_fsblk_t *fblock, ext4_lblk_t *iblock,
+				    uint32_t max_blocks, uint32_t *count);
+
 int ext4_fs_append_inode_dblk(struct ext4_inode_ref *inode_ref,
 			      ext4_fsblk_t *fblock, ext4_lblk_t *iblock);
 
