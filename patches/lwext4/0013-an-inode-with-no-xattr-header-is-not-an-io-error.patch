+/**@brief Has this inode's in-body attribute area ever been written to?
+ *
+ * Separate from ext4_xattr_is_ibody_valid(), which conflates "no header here"
+ * with "the header here is malformed". The set path needs the first question
+ * answered on its own, so it knows when to lay a header down.
  */
+static bool ext4_xattr_ibody_initialized(struct ext4_inode_ref *inode_ref)
+{
+	struct ext4_fs *fs = inode_ref->fs;
+	struct ext4_xattr_ibody_header *iheader;
+
+	if (!ext4_inode_get_extra_isize(&fs->sb, inode_ref->inode))
+		return false;
+
+	iheader = EXT4_XATTR_IHDR(&fs->sb, inode_ref->inode);
+	return iheader->h_magic == to_le32(EXT4_XATTR_MAGIC);
+}
