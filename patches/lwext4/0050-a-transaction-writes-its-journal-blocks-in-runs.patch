+/**@brief  Write-side batch for a transaction's journal blocks.
+ *
+ * The replay and checkpoint paths read and write the log in runs; the commit
+ * path that fills the log did not. Every journal block went out through the
+ * cache carrying BC_TMP and BC_FLUSH, which is precisely the combination that
+ * makes ext4_bcache_free flush it on release -- one 4 KiB device command per
+ * block, issued from inside the loop that builds the transaction. Measured:
+ * 2,000 small files cost 27,930 device writes and 100 MB, for about 20 KB of
+ * file content, and 37% of the commands landed inside the journal.
+ *
+ * A transaction's journal blocks are consecutive by construction --
+ * jbd_journal_alloc_block hands out journal->last++ -- and the journal file
+ * itself is laid down as a long run, so they are almost always physically
+ * contiguous too. This gathers the payload and issues one command per run.
+ *
+ * It bypasses the block cache rather than filling it: nothing reads a journal
+ * block between writing it and the commit, the cache would only be flushed
+ * per block anyway, and any copy left over from an earlier lap of the ring is
+ * invalidated once the new bytes are on the medium. */
+struct jbd_commit_wb {
+	uint8_t *data;      /**< payload, @cnt blocks in arrival order */
+	uint32_t *iblock;   /**< journal block index of each slot */
+	uint8_t *gather;    /**< one contiguous run, assembled for the write */
+	uint32_t cnt;
+	uint32_t cap;
+};
+
+static void jbd_commit_wb_free(struct jbd_commit_wb *wb)
+{
+	if (!wb)
+		return;
+	ext4_free(wb->data);
+	ext4_free(wb->iblock);
+	ext4_free(wb->gather);
+	ext4_free(wb);
+}
+
+/**@brief  Allocate a commit batch. NULL means "write the old way": slower,
+ *         and correct. */
+static struct jbd_commit_wb *jbd_commit_wb_new(struct jbd_fs *jbd_fs,
+					       uint32_t hint)
+{
+	/* Same ceiling the replay batch uses, stated here because that one is
+	 * defined further down with its own machinery. */
+	uint32_t bs = jbd_fs->bdev->lg_bsize;
+	uint32_t cap = (4 * 1024 * 1024) / bs;
+	struct jbd_commit_wb *wb;
+
+	if (hint && hint < cap)
+		cap = hint;
+	if (cap == 0)
+		return NULL;
+
+	wb = ext4_calloc(1, sizeof(*wb));
+	if (!wb)
+		return NULL;
+
+	wb->data = ext4_malloc((size_t)cap * bs);
+	wb->iblock = ext4_malloc((size_t)cap * sizeof(*wb->iblock));
+	wb->gather = ext4_malloc((size_t)cap * bs);
+	if (!wb->data || !wb->iblock || !wb->gather) {
+		jbd_commit_wb_free(wb);
+		return NULL;
+	}
+	wb->cap = cap;
+	return wb;
+}
+
+/**@brief  Issue the batch: one command per physically contiguous run, then
+ *         drop any cached copies of what was written. */
+static int jbd_commit_wb_flush(struct jbd_fs *jbd_fs,
+			       struct jbd_commit_wb *wb)
+{
+	struct ext4_blockdev *bdev = jbd_fs->bdev;
+	uint32_t bs = bdev->lg_bsize;
+	uint32_t i = 0;
+	int rc = EOK;
+
+	while (i < wb->cnt) {
+		ext4_fsblk_t first = 0, next = 0;
+		uint32_t run = 1;
+
+		rc = jbd_inode_bmap(jbd_fs, wb->iblock[i], &first);
+		if (rc != EOK)
+			break;
+
+		memcpy(wb->gather, wb->data + (size_t)i * bs, bs);
+
+		while (i + run < wb->cnt) {
+			rc = jbd_inode_bmap(jbd_fs, wb->iblock[i + run], &next);
+			if (rc != EOK)
+				break;
+			if (next != first + run)
+				break;
+			memcpy(wb->gather + (size_t)run * bs,
+			       wb->data + (size_t)(i + run) * bs, bs);
+			run++;
+		}
+		if (rc != EOK)
+			break;
+
+		rc = ext4_blocks_set_direct(bdev, wb->gather, first, run);
+		if (rc != EOK)
+			break;
+
+		/* The medium now holds these blocks; a resident copy from an
+		 * earlier lap of the ring would be older than what is there. */
+		ext4_bcache_invalidate_lba(bdev->bc, first, run);
+		i += run;
+	}
+
+	wb->cnt = 0;
+	return rc;
 }
 
+/**@brief  Add one journal block to the batch, flushing first when full. */
+static int jbd_commit_wb_record(struct jbd_fs *jbd_fs,
+				struct jbd_commit_wb *wb,
+				uint32_t iblock, const void *payload,
+				bool is_escape)
+{
+	uint32_t bs = jbd_fs->bdev->lg_bsize;
+	uint8_t *slot;
+	int rc;
+
+	if (wb->cnt == wb->cap) {
+		rc = jbd_commit_wb_flush(jbd_fs, wb);
+		if (rc != EOK)
+			return rc;
+	}
+
+	slot = wb->data + (size_t)wb->cnt * bs;
+	memcpy(slot, payload, bs);
+	if (is_escape)
+		((struct jbd_bhdr *)slot)->magic = 0;
+
+	wb->iblock[wb->cnt] = iblock;
+	wb->cnt++;
+	return EOK;
+}
+
