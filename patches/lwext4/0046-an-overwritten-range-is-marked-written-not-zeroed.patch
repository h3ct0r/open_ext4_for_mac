+			  uint32_t max_blocks, ext4_fsblk_t *result,
+			  uint32_t *blocks_count, bool *unwritten);
+
+int ext4_extent_mark_written(struct ext4_inode_ref *inode_ref,
+			     ext4_lblk_t iblock, uint32_t blocks_count);
+
