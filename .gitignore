# Build output
build/
.build/
*.o
*.a
*.dSYM/
DerivedData/

# Bundle output
*.appex/
*.app/
*.dmg

# Signing (never commit secrets)
*.p12
*.mobileprovision
*.provisionprofile
signing.local.env

# Soak logs. Deliberately outside build/, which every soak round deletes.
.soak/

# Fuzzing state: seed corpus, growing corpus, crash artifacts, logs, coverage
# reports. Outside build/ for the same reason .soak/ is -- a validation round
# begins with `make clean`, and a corpus a round deletes is a corpus that never
# grows. Findings that matter are promoted into Tests/fixtures/hostile/ as
# gzipped regression rows, which ARE committed.
.fuzz/

# Test artifacts
Tests/fixtures/*.img
tools/difftest/out/

# Python bytecode from the mutation campaign's modules
__pycache__/
*.pyc

# macOS
.DS_Store
Extension/Ext4FS.entitlements
App/Ext4Mac.entitlements
